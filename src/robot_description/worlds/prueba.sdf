<sdf version='1.10'>
  <world name='empty'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <!-- Plano base -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= MODELOS Y OBJETOS ================= -->

    <!-- Pallet importado -->
    <include>
      <name>mi_pallet</name>
      <uri>model://pallet</uri>
      <pose>1.0 2.0 0 0 0 0</pose>
    </include>

    <!-- Derrame de líquido -->
    <model name='liquido_derrame'>
      <static>true</static>
      <pose>1.0 3.0 0.001 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.5 0.8</ambient>
            <diffuse>0.15 0.4 0.7 0.8</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Persona Rescue Randy -->
    <include>
      <name>persona_randy</name>
      <uri>model://rescue_randy</uri>
      <pose>1.0 -1.55 0 0 0 1.57</pose>
    </include>

    <!-- Persona geométrica simulada (Al otro lado del pasillo, sin cajas, pegada al suelo) -->
    <model name='persona_geometrica'>
      <static>true</static>
      <pose>1.0 -2.5 0 0 0 0</pose>
      <link name='link'>
        <!-- Cuerpo (Cilindro ajustado al suelo: Z = 0.6 para que la base empiece en 0) -->
        <visual name='cuerpo_visual'>
          <pose>0 0 0.6 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.4 0.1 1</ambient>
            <diffuse>0.9 0.5 0.2 1</diffuse>
          </material>
        </visual>
        <collision name='cuerpo_colision'>
          <pose>0 0 0.6 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.2</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- Cabeza (Esfera ubicada justo arriba del cilindro, en Z = 1.35) -->
        <visual name='cabeza_visual'>
          <pose>0 0 1.35 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.15</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.8 0.7 0.6 1</ambient>
            <diffuse>0.9 0.8 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= FILA INFERIOR DE CAJAS ================= -->

    <model name='box_1'>
      <pose>1.0 -0.345 0.125 0 0 0</pose>
      <link name='box_link'>
        <inertial>
          <mass>15.0</mass>
          <inertia>
            <ixx>0.1906</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.2781</iyy><iyz>0</iyz>
            <izz>0.2916</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.3 0.4 0.25</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.3 0.4 0.25</size></box></geometry>
          <material>
            <ambient>0.53 0.39 0.28 1</ambient>
            <diffuse>0.65 0.48 0.35 1</diffuse>
          </material>
        </visual>
      </link>
      <static>false</static>
    </model>

    <model name='box_2'>
      <pose>1.0 0.02 0.150 0 0 0</pose>
      <link name='box_link'>
        <inertial>
          <mass>13.5</mass>
          <inertia>
            <ixx>0.2025</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.2025</iyy><iyz>0</iyz>
            <izz>0.2025</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material>
            <ambient>0.53 0.39 0.28 1</ambient>
            <diffuse>0.65 0.48 0.35 1</diffuse>
          </material>
        </visual>
      </link>
      <static>false</static>
    </model>

    <model name='box_3'>
      <pose>1.0 0.35 0.150 0 0 0</pose>
      <link name='box_link'>
        <inertial>
          <mass>13.5</mass>
          <inertia>
            <ixx>0.2025</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.2025</iyy><iyz>0</iyz>
            <izz>0.2025</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material>
            <ambient>0.53 0.39 0.28 1</ambient>
            <diffuse>0.65 0.48 0.35 1</diffuse>
          </material>
        </visual>
      </link>
      <static>false</static>
    </model>

    <!-- ================= FILA SUPERIOR DE CAJAS ================= -->

    <model name='box_4'>
      <pose>1.0 -0.345 0.402 0 0 0</pose>
      <link name='box_link'>
        <inertial>
          <mass>13.5</mass>
          <inertia>
            <ixx>0.2025</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.2025</iyy><iyz>0</iyz>
            <izz>0.2025</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material>
            <ambient>0.53 0.39 0.28 1</ambient>
            <diffuse>0.65 0.48 0.35 1</diffuse>
          </material>
        </visual>
      </link>
      <static>false</static>
    </model>

    <model name='box_5'>
      <pose>1.0 0.02 0.452 0 0 0</pose>
      <link name='box_link'>
        <inertial>
          <mass>13.5</mass>
          <inertia>
            <ixx>0.2025</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.2025</iyy><iyz>0</iyz>
            <izz>0.2025</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material>
            <ambient>0.53 0.39 0.28 1</ambient>
            <diffuse>0.65 0.48 0.35 1</diffuse>
          </material>
        </visual>
      </link>
      <static>false</static>
    </model>

    <model name='box_6'>
      <pose>1.0 0.35 0.427 0 0 0</pose>
      <link name='box_link'>
        <inertial>
          <mass>15.0</mass>
          <inertia>
            <ixx>0.1906</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.2781</iyy><iyz>0</iyz>
            <izz>0.2916</izz>
          </inertia>
        </inertial>
        <collision name='collision'>
          <geometry><box><size>0.3 0.4 0.25</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.3 0.4 0.25</size></box></geometry>
          <material>
            <ambient>0.53 0.39 0.28 1</ambient>
            <diffuse>0.65 0.48 0.35 1</diffuse>
          </material>
        </visual>
      </link>
      <static>false</static>
    </model>

    <!-- Luz solar -->
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
  </world>
</sdf>