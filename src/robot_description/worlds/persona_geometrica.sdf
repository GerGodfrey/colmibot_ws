<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="persona_geometrica">
    <static>false</static>
    <link name="cuerpo_persona">
      <pose>3.65 -0.50 0.75 0 0 0</pose>
      <gravity>false</gravity>
      <collision name="col">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>1.50</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="vis">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>1.50</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.40 0.10 1</ambient>
          <diffuse>0.90 0.45 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <initial_linear>0 0.15 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>
  </model>
</sdf>