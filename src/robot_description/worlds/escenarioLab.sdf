<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="escenarioLab">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Iluminación -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>3.0 0.0 6.0 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Plano base uniforme -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- PARED TRASERA PEGADA A LAS CAJAS (Y = +0.50 m, H = 0.60m) -->
    <!-- ========================================================= -->
    <model name="pared_cajas">
      <static>true</static>
      <link name="pared_norte">
        <pose>3.00 0.525 0.30 0 0 0</pose>
        <collision name="col"><geometry><box><size>6.00 0.05 0.60</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>6.00 0.05 0.60</size></box></geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- GRUPO 1 DE CAJAS (X = 0.00 a 1.00 m, pegadas a Y = +0.50) -->
    <!-- ========================================================= -->
    <model name="grupo_cajas_1">
      <static>true</static>
      <!-- Fila inferior (Z = 0.15 m) -->
      <link name="g1_caja_inf_1">
        <pose>0.15 0.35 0.15 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.30 0.30 0.30</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.30 0.30 0.30</size></box></geometry>
          <material><ambient>0.65 0.48 0.28 1</ambient><diffuse>0.65 0.48 0.28 1</diffuse></material>
        </visual>
      </link>
      <link name="g1_caja_inf_2">
        <pose>0.50 0.35 0.15 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.40 0.30 0.30</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.40 0.30 0.30</size></box></geometry>
          <material><ambient>0.58 0.42 0.24 1</ambient><diffuse>0.58 0.42 0.24 1</diffuse></material>
        </visual>
      </link>
      <link name="g1_caja_inf_3">
        <pose>0.85 0.35 0.15 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.30 0.30 0.30</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.30 0.30 0.30</size></box></geometry>
          <material><ambient>0.65 0.48 0.28 1</ambient><diffuse>0.65 0.48 0.28 1</diffuse></material>
        </visual>
      </link>

      <!-- Fila superior apilada (Z = 0.45 m) -->
      <link name="g1_caja_sup_1">
        <pose>0.32 0.35 0.45 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.30 0.30 0.30</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.30 0.30 0.30</size></box></geometry>
          <material><ambient>0.72 0.55 0.34 1</ambient><diffuse>0.72 0.55 0.34 1</diffuse></material>
        </visual>
      </link>
      <link name="g1_caja_sup_2">
        <pose>0.68 0.35 0.45 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.40 0.30 0.30</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.40 0.30 0.30</size></box></geometry>
          <material><ambient>0.62 0.45 0.26 1</ambient><diffuse>0.62 0.45 0.26 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- POSTE GRIS 1 (30x20x50 cm, a un lado del Grupo 1) -->
    <model name="poste_gris_1">
      <static>true</static>
      <link name="link">
        <pose>1.15 0.12 0.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.30 0.20 0.50</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.30 0.20 0.50</size></box></geometry>
          <material>
            <ambient>0.42 0.44 0.46 1</ambient>
            <diffuse>0.42 0.44 0.46 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================= -->
    <!-- GRUPO 2 DE CAJAS (X = 2.50 a 3.50 m, pegadas a Y = +0.50) -->
    <!-- ========================================================= -->
    <model name="grupo_cajas_2">
      <static>true</static>
      <!-- Fila inferior (Z = 0.15 m) -->
      <link name="g2_caja_inf_1">
        <pose>2.65 0.35 0.15 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.30 0.30 0.30</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.30 0.30 0.30</size></box></geometry>
          <material><ambient>0.65 0.48 0.28 1</ambient><diffuse>0.65 0.48 0.28 1</diffuse></material>
        </visual>
      </link>
      <link name="g2_caja_inf_2">
        <pose>3.00 0.35 0.15 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.40 0.30 0.30</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.40 0.30 0.30</size></box></geometry>
          <material><ambient>0.58 0.42 0.24 1</ambient><diffuse>0.58 0.42 0.24 1</diffuse></material>
        </visual>
      </link>
      <link name="g2_caja_inf_3">
        <pose>3.35 0.35 0.15 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.30 0.30 0.30</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.30 0.30 0.30</size></box></geometry>
          <material><ambient>0.65 0.48 0.28 1</ambient><diffuse>0.65 0.48 0.28 1</diffuse></material>
        </visual>
      </link>

      <!-- Fila superior apilada (Z = 0.45 m) -->
      <link name="g2_caja_sup_1">
        <pose>2.82 0.35 0.45 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.30 0.30 0.30</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.30 0.30 0.30</size></box></geometry>
          <material><ambient>0.72 0.55 0.34 1</ambient><diffuse>0.72 0.55 0.34 1</diffuse></material>
        </visual>
      </link>
      <link name="g2_caja_sup_2">
        <pose>3.18 0.35 0.45 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.40 0.30 0.30</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.40 0.30 0.30</size></box></geometry>
          <material><ambient>0.62 0.45 0.26 1</ambient><diffuse>0.62 0.45 0.26 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- POSTE GRIS 2 (30x20x50 cm, a un lado del Grupo 2) -->
    <model name="poste_gris_2">
      <static>true</static>
      <link name="link">
        <pose>3.65 0.12 0.25 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.30 0.20 0.50</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.30 0.20 0.50</size></box></geometry>
          <material>
            <ambient>0.42 0.44 0.46 1</ambient>
            <diffuse>0.42 0.44 0.46 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>